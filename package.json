{
  "name": "homecall-card",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Original-voice announcements to Alexa devices from Home Assistant",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write src scripts tests *.json *.md docs .github",
    "format:check": "prettier --check src scripts tests *.json *.md docs .github",
    "test": "node --test tests/*.test.cjs tests/*.test.js",
    "test:browser": "playwright test --config scripts/playwright.config.js",
    "check": "npm run format:check && npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0"
  }
}
